<?xml version="1.0" encoding="utf-8"?>
<!--
  This app stores nothing worth moving between devices — just a time and a repeat
  mode — so both backup and device-to-device transfer are excluded outright.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
