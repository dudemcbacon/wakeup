<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: a clock face. Drawn inside the safe zone (the middle
  72dp of the 108dp canvas) so no part is clipped by the system's icon mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="30"
        android:translateY="30">

        <!-- Face -->
        <path
            android:fillColor="#00000000"
            android:pathData="M24,5 C13.51,5 5,13.51 5,24 C5,34.49 13.51,43 24,43 C34.49,43 43,34.49 43,24 C43,13.51 34.49,5 24,5 Z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4" />

        <!-- Hands, pointing at roughly 7 o'clock -->
        <path
            android:fillColor="#00000000"
            android:pathData="M24,13 L24,24 L17,31"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="4" />
    </group>
</vector>
