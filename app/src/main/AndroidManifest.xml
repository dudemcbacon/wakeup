<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Turning Do Not Disturb off requires this permission AND a special access
      grant the user makes in Settings > Notifications > Do Not Disturb access.
      There is no runtime permission dialog for it; the app sends the user there.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!--
      Fire at the exact configured minute. On Android 13+ the user grants this in
      Settings > Apps > Special app access > Alarms & reminders. Without it the
      app falls back to an inexact alarm that can run minutes late.

      An alarm-clock app may instead declare USE_EXACT_ALARM, which is granted at
      install and cannot be revoked — but Google Play restricts it to apps whose
      core purpose is alarms/calendar, so this app uses the askable permission.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Re-arm the schedule after a reboot or an app update. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Post the "ran at 07:00" confirmation notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Adjust audio state. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wakeup">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fired by AlarmManager at the configured time. -->
        <receiver
            android:name=".WakeupReceiver"
            android:exported="false" />

        <!--
          exported="true" is required to receive these system broadcasts. They are
          all protected broadcasts, so only the OS can deliver them.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
